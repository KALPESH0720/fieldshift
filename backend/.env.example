APP_NAME=Field Shift API
ENVIRONMENT=development
DEBUG=false
# Compose publishes container port 5432 on host port 5434.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/field_shift
REDIS_URL=redis://localhost:6380/0
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_API_KEY=
AGRONOMIST_REVIEWER_KEYS={}
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
OTP_EXPIRE_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_ATTEMPT_LIMIT=5
OTP_ATTEMPT_WINDOW_SECONDS=300
OTP_SEND_LIMIT_PER_IP=10
OTP_SEND_WINDOW_SECONDS=3600
OTP_PROVIDER=development
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_ASR_SERVICE_ID=
BHASHINI_TTS_SERVICE_ID=
BHASHINI_TRANSLATION_SERVICE_ID=
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_API_KEY=
WHATSAPP_SENDER_ID=
# NASA AppEEARS point extraction for SMAP Enhanced L3 9 km daily soil moisture.
NASA_APPEEARS_API_URL=https://appeears.earthdatacloud.nasa.gov/api/
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_SMAP_PRODUCT=SPL3SMP_E.006
NASA_SMAP_MAX_RANGE_DAYS=90
NASA_SMAP_POLL_INTERVAL_SECONDS=5
NASA_SMAP_MAX_WAIT_SECONDS=900
SENTINEL2_PROCESS_URL=
SENTINEL2_TOKEN_URL=https://services.sentinel-hub.com/auth/realms/main/protocol/openid-connect/token
SENTINEL2_CLIENT_ID=
SENTINEL2_CLIENT_SECRET=
AGRISTACK_BASE_URL=
AGRISTACK_TOKEN_URL=
AGRISTACK_CLIENT_ID=
AGRISTACK_CLIENT_SECRET=
SOIL_CARD_OCR_URL=
SOIL_CARD_OCR_API_KEY=
# Private S3-compatible storage and fail-closed ClamAV scanning for soil-card images.
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_SECURE=true
CLAMAV_HOST=
CLAMAV_PORT=3310
SOIL_CARD_MAX_UPLOAD_BYTES=10485760
SOIL_CARD_RETENTION_DAYS=30
SOIL_CARD_OCR_CONFIDENCE_THRESHOLD=0.80
# OGD/AGMARKNET resource endpoint. The URL template is expanded with AGMARKNET_RESOURCE_ID.
AGMARKNET_API_URL=https://api.data.gov.in/resource/{resource_id}
AGMARKNET_RESOURCE_ID=
AGMARKNET_API_KEY=
# Set only after confirming the feed's source unit (for example INR/quintal).
AGMARKNET_DEFAULT_PRICE_UNIT=
AGMARKNET_PAGE_SIZE=1000
AGMARKNET_MAX_PAGES=20
WEATHER_PROVIDER=open_meteo
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_CACHE_SECONDS=1800
WEATHER_FRESHNESS_SECONDS=3600
SOWING_WINDOW_ALERT_THRESHOLD_DAYS=3
ALERT_MAX_ATTEMPTS=5
ALERT_RETRY_BASE_SECONDS=300        
REMINDER_SMS_ENABLED=true
REMINDER_WHATSAPP_ENABLED=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
