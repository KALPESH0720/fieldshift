# ----------------------------------------------------------------------
# Field Shift Suggestion Engine - Environment Configuration
# ----------------------------------------------------------------------

# --- Core Service & Security ---
FIELDSHIFT_API_KEY=dev-suggestion-engine-key-32chars
FIELDSHIFT_PORT=8080
FIELDSHIFT_KNOWLEDGE_DIR=knowledge

# --- Pilot Region & Resolution ---
FIELDSHIFT_REGION=pune_demo
FIELDSHIFT_CELL_SIZE_DEG=0.1
FIELDSHIFT_SEASON_CYCLE=kharif,rabi
FIELDSHIFT_HORIZON_SEASONS=2
FIELDSHIFT_TOP_N=3
FIELDSHIFT_SCENARIO=ssp245

# --- Fast Tier / Offline Layer Data ---
# For local development:
FIELDSHIFT_CELLS_PATH=tests/fixtures/pilot_cells.json
# For GCP production with Vertex:
# FIELDSHIFT_CELLS_PATH=gs://your-fieldshift-bucket/data/layers/pune_demo/2026a/cells.json

# --- Deep Tier Launcher (none | local | vertex) ---
# 'none': recommendations use only fast tier cache/rules without kicking off simulation
# 'local': runs P2 simulation in background thread in the same process
# 'vertex': launches P2 pipeline in Google Cloud Vertex AI Pipelines
FIELDSHIFT_LAUNCHER=local

# --- Google Cloud & Vertex AI Pipelines Setup ---
# Required when FIELDSHIFT_LAUNCHER=vertex:
FIELDSHIFT_GCP_PROJECT=your-gcp-project-id
FIELDSHIFT_GCP_REGION=asia-south1
FIELDSHIFT_PIPELINE_ROOT=gs://your-fieldshift-bucket/pipeline-root
FIELDSHIFT_DATA_ROOT=gs://your-fieldshift-bucket/data
FIELDSHIFT_SERVICE_ACCOUNT=fieldshift-pipelines@your-gcp-project-id.iam.gserviceaccount.com
FIELDSHIFT_ENGINE_URL=https://fieldshift-suggestion-engine-url.run.app
FIELDSHIFT_P2_TEMPLATE=gs://your-fieldshift-bucket/templates/p2.yaml

# Base container image built from docker/pipeline-base.Dockerfile:
FIELDSHIFT_BASE_IMAGE=asia-south1-docker.pkg.dev/your-gcp-project-id/fieldshift/pipeline:0.1

