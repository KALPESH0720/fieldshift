
# FieldShift environment
APP_NAME=FieldShift
APP_ENV=production
LOG_LEVEL=INFO

# Pipeline execution
FIELDSHIFT_EXECUTION_MODE=pipeline
FIELDSHIFT_CONFIG_PATH=infra/config/app.yaml

# NASA API
NASA_API_KEY=DEMO_KEY
NASA_API_BASE_URL=https://api.nasa.gov

# Runtime
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
